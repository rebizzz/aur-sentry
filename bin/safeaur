#!/usr/bin/env bash
# safeaur - Pre-install supply-chain verification for paru / yay
# Usage:
#   safeaur check [--strict] <package-name>
#   safeaur scan <path/to/PKGBUILD>
#   safeaur update-cache

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/safeaur"
ADVISORIES_CACHE="$CACHE_DIR/advisories.json"
FEED_URL="https://raw.githubusercontent.com/rebizzz/aur-sentry/main/advisories.json"

# Attestation registry (see ARCHITECTURE.md): data/attestations/<pkg>/<version>.json,
# published straight from the repo over raw.githubusercontent.com. No auth needed.
ATTESTATION_RAW_BASE="https://raw.githubusercontent.com/rebizzz/aur-sentry/main/data/attestations"
ATTESTATION_API_BASE="https://api.github.com/repos/rebizzz/aur-sentry/contents/data/attestations"

# ANSI Colors
RED="\033[1;31m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
CYAN="\033[1;36m"
MAGENTA="\033[1;35m"
DIM="\033[2m"
BOLD="\033[1m"
RESET="\033[0m"

# Nerdfont Glyphs
ICON_SHIELD="󰒃"
ICON_SKULL="󰚌"
ICON_WARN="󰀦"
ICON_CHECK="󰄬"
ICON_CROSS="󰅖"
ICON_DOWNLOAD="󰇚"

mkdir -p "$CACHE_DIR"

# Locate aur-sentry binary
AUR_SENTRY_BIN=""
if [ -x "$REPO_ROOT/target/release/aur-sentry" ]; then
    AUR_SENTRY_BIN="$REPO_ROOT/target/release/aur-sentry"
elif command -v aur-sentry >/dev/null 2>&1; then
    AUR_SENTRY_BIN="$(command -v aur-sentry)"
fi

update_cache() {
    echo -e "${CYAN}${ICON_DOWNLOAD} Fetching latest AUR-Sentry advisories...${RESET}"
    if curl -fsSL "$FEED_URL" -o "$ADVISORIES_CACHE.tmp" 2>/dev/null; then
        mv "$ADVISORIES_CACHE.tmp" "$ADVISORIES_CACHE"
        echo -e "${GREEN}${ICON_CHECK} Advisory feed synced.${RESET}"
    else
        rm -f "$ADVISORIES_CACHE.tmp"
        echo -e "${YELLOW}${ICON_WARN} Offline or unreachable. Using cached advisories if present.${RESET}"
    fi
}

# Look up the attestation registry for a package (see ARCHITECTURE.md
# "Attestation" / "Registry" stages, and data/attestations/<pkg>/<version>.json).
# Fetches the latest version's attestation straight from
# raw.githubusercontent.com (free, no auth, public repo) via the GitHub
# Contents API for directory listing.
#
# Sets globals on return: ATT_FOUND (0/1), ATT_VERDICT, ATT_VERSION.
# Never hangs (short curl timeouts) and never treats a network/404 failure
# as anything other than "no attestation found" — the registry is new and
# sparse, so missing data must never break a normal install.
ATT_FOUND=0
ATT_VERDICT=""
ATT_VERSION=""

fetch_attestation() {
    local pkg="$1"
    ATT_FOUND=0
    ATT_VERDICT=""
    ATT_VERSION=""

    command -v curl >/dev/null 2>&1 || return 0

    local listing
    listing="$(curl -fsSL --max-time 5 "$ATTESTATION_API_BASE/$pkg" 2>/dev/null)" || return 0
    [ -n "$listing" ] || return 0

    # Extract "<version>.json" entry names, take the highest version (sort -V)
    # as "the latest version's attestation" per the registry policy.
    local latest
    latest="$(grep -Eo '"name"[[:space:]]*:[[:space:]]*"[^"]+\.json"' <<<"$listing" \
        | sed -E 's/.*"([^"]+)\.json"$/\1/' \
        | sort -V | tail -n1)"
    [ -n "$latest" ] || return 0

    local attestation
    attestation="$(curl -fsSL --max-time 5 "$ATTESTATION_RAW_BASE/$pkg/$latest.json" 2>/dev/null)" || return 0
    [ -n "$attestation" ] || return 0

    local verdict
    verdict="$(grep -Eo '"verdict"[[:space:]]*:[[:space:]]*"[^"]*"' <<<"$attestation" \
        | head -n1 | sed -E 's/.*"([^"]*)"$/\1/')"
    [ -n "$verdict" ] || return 0

    ATT_FOUND=1
    ATT_VERDICT="$verdict"
    ATT_VERSION="$latest"
    return 0
}

# Preferred registry lookup: delegate to `aur-sentry check <pkg>` when the
# binary is available (it prints the full evidence checklist). Its exit code
# is 0 for VERIFIED or "no attestation yet", 2 for any other verdict; the
# verdict itself is read from its "verdict: X" line so safeaur's own
# SUSPICIOUS/MALICIOUS policy below still applies. Returns 1 (caller falls
# back to the curl path) if the binary is missing, too old to have `check`,
# or its output can't be interpreted.
check_via_aur_sentry() {
    local pkg="$1" out rc=0 verdict
    [ -n "$AUR_SENTRY_BIN" ] || return 1
    out="$("$AUR_SENTRY_BIN" check "$pkg" 2>&1)" || rc=$?
    out="$(sed -E 's/\x1b\[[0-9;]*[mK]//g' <<<"$out")"
    verdict="$(grep -Eo 'verdict: *[A-Za-z_]+' <<<"$out" | tail -n1 | sed -E 's/verdict: *//' \
        | sed -E 's/([a-z])([A-Z])/\1_\2/g' | tr '[:lower:]' '[:upper:]' || true)"

    case "$rc" in
        0)
            [ -n "$out" ] && echo "$out" >&2
            ATT_VERSION="$(grep -Eo ' v[^ ]+$' <<<"$out" | head -n1 | sed -E 's/^ v//' || true)"
            if [ -n "$verdict" ]; then
                ATT_FOUND=1
                ATT_VERDICT="VERIFIED"
            else
                ATT_FOUND=0
            fi
            return 0
            ;;
        2)
            [ -n "$verdict" ] || return 1
            echo "$out" >&2
            ATT_VERSION="$(grep -Eo ' v[^ ]+$' <<<"$out" | head -n1 | sed -E 's/^ v//' || true)"
            ATT_FOUND=1
            ATT_VERDICT="$verdict"
            return 0
            ;;
    esac
    return 1
}

# Apply the attestation verdict policy (see ARCHITECTURE.md "Verdict states"):
#   VERIFIED             -> continue silently
#   STALE / no attestation -> warn but allow (registry is new/sparse)
#   SUSPICIOUS            -> warn loudly; interactive: confirm to proceed;
#                             --strict or non-interactive: block
#   MALICIOUS             -> block unconditionally
# INCONCLUSIVE/BUILD_FAILED/ANALYSIS_FAILED/UNSUPPORTED are treated like
# STALE/UNKNOWN — informational only, never block a build on their own.
check_attestation_policy() {
    local pkg="$1"
    local strict="$2"

    ATT_FOUND=0
    ATT_VERDICT=""
    ATT_VERSION=""
    if ! check_via_aur_sentry "$pkg"; then
        fetch_attestation "$pkg"
    fi

    if [ "$ATT_FOUND" -ne 1 ]; then
        echo -e "${YELLOW}${ICON_WARN} safeaur: no attestation on record for '$pkg' yet — registry is still sparse, proceeding.${RESET}"
        return 0
    fi

    case "$ATT_VERDICT" in
        VERIFIED)
            : # continue silently
            ;;
        MALICIOUS)
            echo -e "${RED}${BOLD}${ICON_SKULL} MALICIOUS: attestation registry flags '$pkg' (v${ATT_VERSION}) as MALICIOUS!${RESET}"
            echo -e "${RED}  Details: https://github.com/rebizzz/aur-sentry/tree/main/data/attestations/$pkg${RESET}"
            echo -e "${YELLOW}  Aborting build hook unconditionally.${RESET}"
            exit 3
            ;;
        SUSPICIOUS)
            echo -e "${YELLOW}${BOLD}${ICON_WARN} SUSPICIOUS: attestation registry flags '$pkg' (v${ATT_VERSION}) as SUSPICIOUS.${RESET}"
            echo -e "${YELLOW}  Details: https://github.com/rebizzz/aur-sentry/tree/main/data/attestations/$pkg${RESET}"
            if [ "$strict" = "1" ] || [ ! -t 0 ]; then
                echo -e "${RED}  Non-interactive or --strict: aborting build hook.${RESET}"
                exit 3
            fi
            read -r -p "$(echo -e "${YELLOW}  Proceed anyway? [y/N]:${RESET} ")" reply
            case "$reply" in
                [yY]|[yY][eE][sS]) : ;;
                *)
                    echo -e "${RED}  Aborting build hook.${RESET}"
                    exit 3
                    ;;
            esac
            ;;
        STALE)
            echo -e "${YELLOW}${ICON_WARN} safeaur: attestation for '$pkg' is STALE (AUR commit moved since last scan) — proceeding.${RESET}"
            ;;
        *)
            echo -e "${YELLOW}${ICON_WARN} safeaur: attestation for '$pkg' is ${ATT_VERDICT:-UNKNOWN} — proceeding.${RESET}"
            ;;
    esac
    return 0
}

cmd_check() {
    local strict="0"
    local pkg=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --strict)
                strict="1"
                shift
                ;;
            *)
                pkg="$1"
                shift
                ;;
        esac
    done

    if [ -z "$pkg" ]; then
        echo -e "${RED}${ICON_CROSS} Error: Package name required.${RESET}"
        echo "Usage: safeaur check [--strict] <package-name>"
        exit 1
    fi

    # Refresh cache if older than 1 hour or missing
    if [ ! -f "$ADVISORIES_CACHE" ] || [ $(($(date +%s) - $(stat -c %Y "$ADVISORIES_CACHE" 2>/dev/null || stat -f %m "$ADVISORIES_CACHE" 2>/dev/null || echo 0))) -gt 3600 ]; then
        update_cache >/dev/null 2>&1 || true
    fi

    # 1. Check local threat advisory cache
    if [ -f "$ADVISORIES_CACHE" ]; then
        if grep -qi "\"package\":\s*\"$pkg\"" "$ADVISORIES_CACHE"; then
            echo -e "${RED}${BOLD}${ICON_SKULL} THREAT ALERT: '$pkg' has an active security advisory in AUR-Sentry!${RESET}"
            echo -e "${RED}  Details: https://github.com/rebizzz/aur-sentry/blob/main/ADVISORIES.md${RESET}"
            echo -e "${YELLOW}  Aborting build hook. Inspect the PKGBUILD before proceeding!${RESET}"
            exit 2
        fi
    fi

    # 2. Check the attestation registry (VERIFIED/SUSPICIOUS/MALICIOUS/STALE/UNKNOWN)
    check_attestation_policy "$pkg" "$strict"

    # 3. Run real-time heuristic scan if aur-sentry binary is available
    if [ -n "$AUR_SENTRY_BIN" ]; then
        "$AUR_SENTRY_BIN" scan-pkg "$pkg"
        exit $?
    fi

    echo -e "${GREEN}${ICON_CHECK} safeaur: No active threat advisories for '$pkg'.${RESET}"
    exit 0
}

cmd_scan() {
    local target="${1:-}"
    if [ -z "$target" ] || [ ! -f "$target" ]; then
        echo -e "${RED}${ICON_CROSS} Error: PKGBUILD file path required.${RESET}"
        echo "Usage: safeaur scan <path/to/PKGBUILD>"
        exit 1
    fi

    if [ -n "$AUR_SENTRY_BIN" ]; then
        "$AUR_SENTRY_BIN" scan-file "$target"
        exit $?
    fi

    echo -e "${RED}${ICON_CROSS} Error: aur-sentry binary not found. Build it with 'cargo build --release' first.${RESET}"
    exit 1
}

case "${1:-help}" in
    check)
        shift
        cmd_check "$@"
        ;;
    scan)
        shift
        cmd_scan "$@"
        ;;
    update-cache)
        update_cache
        ;;
    *)
        echo -e "${CYAN}${BOLD}${ICON_SHIELD}  AUR-Sentry Client (${MAGENTA}safeaur${CYAN})${RESET}"
        echo -e "${DIM}   Supply-chain threat verification for Arch Linux package managers${RESET}"
        echo ""
        echo "Usage:"
        echo "  safeaur check <package-name>   Check threat radar and scan live AUR PKGBUILD"
        echo "  safeaur scan <file>            Scan local PKGBUILD/.install for attack signatures"
        echo "  safeaur update-cache           Manually refresh threat advisory feed"
        exit 0
        ;;
esac
