#!/usr/bin/env bash
# safeaur - Pre-install supply-chain verification for paru / yay
# Usage:
#   safeaur check <package-name>
#   safeaur scan <path/to/PKGBUILD>
#   safeaur update-cache

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/safeaur"
ADVISORIES_CACHE="$CACHE_DIR/advisories.json"
FEED_URL="https://raw.githubusercontent.com/rebizzz/aur-sentry/main/advisories.json"

# ANSI Colors
RED="\033[1;31m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
CYAN="\033[1;36m"
MAGENTA="\033[1;35m"
DIM="\033[2m"
BOLD="\033[1m"
RESET="\033[0m"

# Nerdfont Glyphs
ICON_SHIELD="󰒃"
ICON_SKULL="󰚌"
ICON_WARN="󰀦"
ICON_CHECK="󰄬"
ICON_CROSS="󰅖"
ICON_DOWNLOAD="󰇚"

mkdir -p "$CACHE_DIR"

# Locate aur-sentry binary
AUR_SENTRY_BIN=""
if [ -x "$REPO_ROOT/target/release/aur-sentry" ]; then
    AUR_SENTRY_BIN="$REPO_ROOT/target/release/aur-sentry"
elif command -v aur-sentry >/dev/null 2>&1; then
    AUR_SENTRY_BIN="$(command -v aur-sentry)"
fi

update_cache() {
    echo -e "${CYAN}${ICON_DOWNLOAD} Fetching latest AUR-Sentry advisories...${RESET}"
    if curl -fsSL "$FEED_URL" -o "$ADVISORIES_CACHE.tmp" 2>/dev/null; then
        mv "$ADVISORIES_CACHE.tmp" "$ADVISORIES_CACHE"
        echo -e "${GREEN}${ICON_CHECK} Advisory feed synced.${RESET}"
    else
        rm -f "$ADVISORIES_CACHE.tmp"
        echo -e "${YELLOW}${ICON_WARN} Offline or unreachable. Using cached advisories if present.${RESET}"
    fi
}

cmd_check() {
    local pkg="${1:-}"
    if [ -z "$pkg" ]; then
        echo -e "${RED}${ICON_CROSS} Error: Package name required.${RESET}"
        echo "Usage: safeaur check <package-name>"
        exit 1
    fi

    # Refresh cache if older than 1 hour or missing
    if [ ! -f "$ADVISORIES_CACHE" ] || [ $(($(date +%s) - $(stat -c %Y "$ADVISORIES_CACHE" 2>/dev/null || stat -f %m "$ADVISORIES_CACHE" 2>/dev/null || echo 0))) -gt 3600 ]; then
        update_cache >/dev/null 2>&1 || true
    fi

    # 1. Check local threat advisory cache
    if [ -f "$ADVISORIES_CACHE" ]; then
        if grep -qi "\"package\":\s*\"$pkg\"" "$ADVISORIES_CACHE"; then
            echo -e "${RED}${BOLD}${ICON_SKULL} THREAT ALERT: '$pkg' has an active security advisory in AUR-Sentry!${RESET}"
            echo -e "${RED}  Details: https://github.com/rebizzz/aur-sentry#recent-threat-radar${RESET}"
            echo -e "${YELLOW}  Aborting build hook. Inspect the PKGBUILD before proceeding!${RESET}"
            exit 2
        fi
    fi

    # 2. Run real-time heuristic scan if aur-sentry binary is available
    if [ -n "$AUR_SENTRY_BIN" ]; then
        "$AUR_SENTRY_BIN" scan-pkg "$pkg"
        exit $?
    fi

    echo -e "${GREEN}${ICON_CHECK} safeaur: No active threat advisories for '$pkg'.${RESET}"
    exit 0
}

cmd_scan() {
    local target="${1:-}"
    if [ -z "$target" ] || [ ! -f "$target" ]; then
        echo -e "${RED}${ICON_CROSS} Error: PKGBUILD file path required.${RESET}"
        echo "Usage: safeaur scan <path/to/PKGBUILD>"
        exit 1
    fi

    if [ -n "$AUR_SENTRY_BIN" ]; then
        "$AUR_SENTRY_BIN" scan-file "$target"
        exit $?
    fi

    echo -e "${RED}${ICON_CROSS} Error: aur-sentry binary not found. Build it with 'cargo build --release' first.${RESET}"
    exit 1
}

case "${1:-help}" in
    check)
        shift
        cmd_check "$@"
        ;;
    scan)
        shift
        cmd_scan "$@"
        ;;
    update-cache)
        update_cache
        ;;
    *)
        echo -e "${CYAN}${BOLD}${ICON_SHIELD}  AUR-Sentry Client (${MAGENTA}safeaur${CYAN})${RESET}"
        echo -e "${DIM}   Supply-chain threat verification for Arch Linux package managers${RESET}"
        echo ""
        echo "Usage:"
        echo "  safeaur check <package-name>   Check threat radar and scan live AUR PKGBUILD"
        echo "  safeaur scan <file>            Scan local PKGBUILD/.install for attack signatures"
        echo "  safeaur update-cache           Manually refresh threat advisory feed"
        exit 0
        ;;
esac
