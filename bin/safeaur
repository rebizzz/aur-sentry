#!/usr/bin/env bash
# safeaur - Pre-install integrity check for yay / paru
#
# Usage:
#   safeaur check <package-name>
#   safeaur scan <path/to/PKGBUILD>
#   safeaur update-cache

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/safeaur"
ADVISORIES_CACHE="$CACHE_DIR/advisories.json"
FEED_URL="https://raw.githubusercontent.com/rebizzz/aur-sentry/main/advisories.json"

RED="\033[1;31m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
CYAN="\033[1;36m"
BOLD="\033[1m"
RESET="\033[0m"

mkdir -p "$CACHE_DIR"

update_cache() {
    echo -e "${CYAN}[*] Fetching latest AUR-Sentry advisories...${RESET}"
    if curl -fsSL "$FEED_URL" -o "$ADVISORIES_CACHE.tmp" 2>/dev/null; then
        mv "$ADVISORIES_CACHE.tmp" "$ADVISORIES_CACHE"
        echo -e "${GREEN}[+] Cache updated successfully.${RESET}"
    else
        rm -f "$ADVISORIES_CACHE.tmp"
        echo -e "${YELLOW}[!] Warning: Could not reach online advisory feed. Using local cache if present.${RESET}"
    fi
}

cmd_check() {
    local pkg="${1:-}"
    if [ -z "$pkg" ]; then
        echo -e "${RED}Error: Package name required.${RESET}"
        echo "Usage: safeaur check <package-name>"
        exit 1
    fi

    # Refresh cache if older than 1 hour or missing
    if [ ! -f "$ADVISORIES_CACHE" ] || [ $(($(date +%s) - $(stat -c %Y "$ADVISORIES_CACHE" 2>/dev/null || stat -f %m "$ADVISORIES_CACHE"))) -gt 3600 ]; then
        update_cache >/dev/null 2>&1 || true
    fi

    # 1. Check local advisory feed
    if [ -f "$ADVISORIES_CACHE" ]; then
        if grep -qi "\"package\":\s*\"$pkg\"" "$ADVISORIES_CACHE"; then
            echo -e "${RED}${BOLD}[!] ALERT: '$pkg' has an active security advisory in AUR-Sentry!${RESET}"
            echo -e "${RED}Details: https://github.com/rebizzz/aur-sentry#recent-radar${RESET}"
            echo -e "Inspect the PKGBUILD before proceeding!"
            exit 2
        fi
    fi

    # 2. Run real-time heuristic scan if python engine is available
    if command -v python3 >/dev/null 2>&1 && [ -f "$REPO_ROOT/src/main.py" ]; then
        PYTHONPATH="$REPO_ROOT" python3 -m src.main scan-pkg "$pkg"
        exit $?
    fi

    echo -e "${GREEN}[+] safeaur: No known advisories for '$pkg'.${RESET}"
    exit 0
}

cmd_scan() {
    local target="${1:-}"
    if [ -z "$target" ] || [ ! -f "$target" ]; then
        echo -e "${RED}Error: PKGBUILD file path required.${RESET}"
        echo "Usage: safeaur scan <path/to/PKGBUILD>"
        exit 1
    fi

    if command -v python3 >/dev/null 2>&1 && [ -f "$REPO_ROOT/src/main.py" ]; then
        PYTHONPATH="$REPO_ROOT" python3 -m src.main scan-file "$target"
        exit $?
    fi

    echo -e "${RED}Error: python3 or aur-sentry engine not found.${RESET}"
    exit 1
}

case "${1:-help}" in
    check)
        shift
        cmd_check "$@"
        ;;
    scan)
        shift
        cmd_scan "$@"
        ;;
    update-cache)
        update_cache
        ;;
    *)
        echo -e "${BOLD}AUR-Sentry Client (${CYAN}safeaur${RESET}${BOLD})${RESET}"
        echo "Supply-chain security verification for AUR packages."
        echo ""
        echo "Usage:"
        echo "  safeaur check <package-name>   Check advisory list and scan live AUR PKGBUILD"
        echo "  safeaur scan <file>            Scan local PKGBUILD for malicious signatures"
        echo "  safeaur update-cache           Manually refresh threat advisory feed"
        exit 0
        ;;
esac
